# ── API ────────────────────────────────────────────────────────────────
# Neon PostgreSQL (https://neon.tech)
# Use the DIRECT connection string (not the pooled/pgbouncer one) for the
# long-running Express server. It looks like:
#   postgresql://user:pass@ep-xxxx-yyyy.region.aws.neon.tech/smit_teacher_agent?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxxx-yyyy.region.aws.neon.tech/smit_teacher_agent?sslmode=require

# Qdrant Cloud (https://cloud.qdrant.io)
# URL format: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=https://xxxxxx.yyyy.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smit_course_docs

# LLM provider: "gemini" | "openrouter"
LLM_PROVIDER=gemini
# Gemini (https://aistudio.google.com/apikey) — used for chat + embeddings
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
EMBEDDING_DIM=768
# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_32_chars_minimum
JWT_REFRESH_SECRET=change_me_refresh_32_chars_minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Only POST /auth/admin/seed with this secret creates an admin
ADMIN_SEED_SECRET=change_me_admin_seed

# App
NODE_ENV=development
# Render/Railway inject PORT automatically; API_PORT is a fallback for local dev
API_PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,https://<your-app>.vercel.app
MAX_FILE_MB=15
# NOTE: uploaded files are stored on the server's local disk. On Render/Railway
# that disk is ephemeral — files are lost on redeploy and must be re-uploaded.
STORAGE_DIR=./storage
LOG_LEVEL=info

# ── Web ────────────────────────────────────────────────────────────────
# For Vercel, set this to the deployed API URL, e.g. https://<api>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000
