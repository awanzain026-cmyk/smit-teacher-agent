{
  "name": "smit-teacher-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @smit/api\" \"next dev\"",
    "dev:api": "npm run dev -w @smit/api",
    "build": "next build",
    "build:api": "npm run build -w @smit/shared && npm run build -w @smit/api",
    "start": "next start",
    "lint": "next lint && npm run lint -w @smit/api",
    "typecheck": "tsc --noEmit && npm run typecheck -w @smit/api && npm run typecheck -w @smit/shared",
    "test": "npm run test -w @smit/api",
    "db:generate": "npm run db:generate -w @smit/api",
    "db:deploy": "npm run db:deploy -w @smit/api",
    "db:migrate": "npm run db:migrate -w @smit/api",
    "db:seed": "npm run db:seed -w @smit/api",
    "start:api": "npm run start:prod -w @smit/api"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
